# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_eldom
DB_USER=erp_admin
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ─── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_super_long_random_string_in_production_min_64_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Security ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ─── CORS ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
